# Variables de entorno de SisAlert para producción (Docker Compose / Azure).
# Copiar a ".env" y completar. ".env" está en .gitignore: NUNCA subir valores reales.
# En Azure estos valores van como secretos (Key Vault) referenciados desde cada Container App.
# En desarrollo local no hace falta nada de esto: cada servicio trae su perfil "dev".

# ---------- Base de datos (PostgreSQL) ----------
# Azure Database for PostgreSQL exige SSL: dejar sslmode=require / SSL Mode=Require.
# Un usuario por servicio, creado una vez con infra/db/usuarios-por-servicio.sql:
# cada uno solo puede tocar su propio esquema.
DB_URL=jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/sisalert?sslmode=require
DB_USER=alertas_app
DB_PASSWORD=<contraseña-de-alertas_app>
# Solo para una base en red privada sin SSL (p. ej. Docker Compose local). En Azure, no definir.
# DB_SSL_OPCIONAL=true
ConnectionStrings__Identity=Host=<servidor>.postgres.database.azure.com;Port=5432;Database=sisalert;Username=identidad_app;Password=<contraseña-de-identidad_app>;SSL Mode=Require;Maximum Pool Size=10
# Con usuarios por servicio, el historial de migraciones de EF Core va en el esquema propio.
Persistencia__EsquemaHistorial=identidad

# ---------- JWT ----------
# Clave de firma compartida entre la API de identidad y alertas-service (mínimo 32 caracteres).
# Generar una aleatoria, por ejemplo en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
Jwt__Key=<clave-aleatoria-de-al-menos-32-caracteres>

# ---------- API de identidad (.NET) ----------
ASPNETCORE_ENVIRONMENT=Production
# Contraseña inicial del usuario "admin"; solo se usa si ese usuario todavía no existe.
Seed__AdminPassword=<contraseña-fuerte-para-admin>

# ---------- Microservicio de alertas (Spring Boot) ----------
SPRING_PROFILES_ACTIVE=prod
# Origen(es) del frontend desplegado, separados por comas.
ALERTAS_CORS_ORIGENES=https://<frontend>.azurestaticapps.net
# Fuente de datos: open-meteo | ideam | simulada | escenario
ALERTAS_FUENTE=open-meteo
# Opcional: token de datos.gov.co si ALERTAS_FUENTE=ideam
ALERTAS_IDEAM_APP_TOKEN=
