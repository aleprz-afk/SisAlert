# Copiar este archivo a .env.local y ajustar si hace falta.
#
# Modo demostración de alertas (alertasApi.js):
#   true     -> siempre usa los datos simulados de alertasMock.js
#   false    -> siempre usa el alertas-service; si no responde, muestra el error
#   ausente  -> automático: cae al mock solo si el servicio no está corriendo
VITE_MOCK_ALERTAS=
